# rust-assistant Environment Variables
# Copy this file to .env and customize.
# These override settings in Assistant.toml
#
# .env is auto-loaded on startup — no export needed.
# Values set in the shell environment take precedence over .env.

# Ollama server address
# OLLAMA_SERVER=127.0.0.1:11434

# Ollama model name
# OLLAMA_MODEL=gemma3:latest

# TTS voice name (Jasper, Luna, Bella, Bruno, Rosie, Hugo, Kiki, Leo)
# TTS_VOICE=Jasper

# Local TTS model directory (optional — auto-downloads from HuggingFace)
# TTS_MODEL_DIR=models/kitten-tts-mini

# TTS speech speed (0.5–2.0)
# TTS_SPEED=1.0

# Path to Whisper STT model
# STT_MODEL_PATH=models/ggml-tiny.en.bin

# STT language (auto-detect or ISO code like en, fr, de, ja)
# STT_LANGUAGE=auto

# Audio output device name (partial match, run doctor for full list)
# AUDIO_OUTPUT_DEVICE=Speaker
